// Prisma schema for the ERP Platform Foundation.
//
// Ownership note (multi-agent repo): this file is a shared resource.
// - `User`, `UserCredential`, `Session` below are owned by FOUNDATION-001 (Claude / core/auth, core/users).
// - Tenant, Organization, Company, Membership, Role/Permission models are owned by other
//   Foundation tasks (see docs/tasks/CURRENT.md) and should be appended, not interleaved,
//   by whoever implements them, to keep diffs reviewable.
//
// Conventions (docs/ARCHITECTURE.md §8, docs/MULTITENANCY.md):
// - snake_case table/column names via @map/@@map, PascalCase/camelCase in Prisma/TS.
// - UUIDv7 primary keys generated in application code (see packages/database/src/ids.ts),
//   not database-generated, so ordering/portability don't depend on a Postgres extension.
// - timestamptz in UTC for all instants.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Global authentication identity (docs/MULTITENANCY.md §4.8).
/// Not tenant-scoped: a User can hold Memberships in multiple tenants.
/// Tenant-scoped authorization (Membership, RoleAssignment) is out of scope
/// for FOUNDATION-001 and owned by the Access Control / Tenancy tracks.
model User {
  id              String     @id @db.Uuid
  email           String     @unique @db.VarChar(320)
  displayName     String     @map("display_name") @db.VarChar(200)
  status          UserStatus @default(ACTIVE)
  isPlatformAdmin Boolean    @default(false) @map("is_platform_admin")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  credential               UserCredential?
  sessions                 Session[]
  memberships              Membership[]
  preferences              UserPreference[]
  auditEntries             AuditEntry[]
  outboxMessages           OutboxMessage[]
  ownedFiles               FileObject[]
  notifications            Notification[]
  inventoryMovements       InventoryMovement[]
  posShiftsOpened          PosShift[]          @relation("PosShiftsOpened")
  posShiftsClosed          PosShift[]          @relation("PosShiftsClosed")
  posCashMovementsRecorded PosCashMovement[]   @relation("PosCashMovementsRecorded")

  @@map("users")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// Password credential for a User. Kept separate from User so additional
/// credential types (future: passkeys, OAuth identities) don't overload one row.
/// `passwordHash` is a self-describing PHC-format string (algorithm, version
/// and parameters embedded) — see ADR-006 — so no separate algorithm column
/// is needed; the hasher can detect stale parameters directly from the hash.
model UserCredential {
  id           String   @id @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

/// A logged-in session: one row per session, tokens rotate in place on refresh
/// (docs/DECISIONS.md ADR-006). Revocation is explicit and immediate.
model Session {
  id               String        @id @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  accessTokenHash  String        @unique @map("access_token_hash") @db.VarChar(64)
  refreshTokenHash String        @unique @map("refresh_token_hash") @db.VarChar(64)
  status           SessionStatus @default(ACTIVE)
  accessExpiresAt  DateTime      @map("access_expires_at") @db.Timestamptz(6)
  refreshExpiresAt DateTime      @map("refresh_expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt       DateTime      @default(now()) @map("last_used_at") @db.Timestamptz(6)
  ipAddress        String?       @map("ip_address") @db.VarChar(64)
  userAgent        String?       @map("user_agent") @db.VarChar(512)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum SessionStatus {
  ACTIVE
  REVOKED
}

/// Customer account and primary isolation boundary.
model Tenant {
  id        String       @id @db.Uuid
  slug      String       @unique @db.VarChar(63)
  name      String       @db.VarChar(200)
  status    TenantStatus @default(PROVISIONING)
  version   Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships           Membership[]
  organizations         Organization[]
  companies             Company[]
  roles                 Role[]
  roleAssignments       RoleAssignment[]
  settingValues         SettingValue[]
  auditEntries          AuditEntry[]
  outboxMessages        OutboxMessage[]
  fileObjects           FileObject[]
  notifications         Notification[]
  inboxMessages         InboxMessage[]
  tenantApps            TenantApp[]
  unitsOfMeasure        UnitOfMeasure[]
  categories            Category[]
  brands                Brand[]
  products              Product[]
  productVariants       ProductVariant[]
  customers             Customer[]
  suppliers             Supplier[]
  taxes                 Tax[]
  warehouses            Warehouse[]
  priceLists            PriceList[]
  priceListItems        PriceListItem[]
  inventoryMovements    InventoryMovement[]
  inventoryBalances     InventoryBalance[]
  inventoryTransfers    InventoryTransfer[]
  inventoryReservations InventoryReservation[]
  quotes                Quote[]
  quoteLines            QuoteLine[]
  salesOrders           SalesOrder[]
  salesOrderLines       SalesOrderLine[]
  salesReturns          SalesReturn[]
  salesReturnLines      SalesReturnLine[]
  payments              Payment[]
  purchaseOrders        PurchaseOrder[]
  purchaseOrderLines    PurchaseOrderLine[]
  purchaseReceipts      PurchaseReceipt[]
  purchaseReceiptLines  PurchaseReceiptLine[]
  purchaseReturns       PurchaseReturn[]
  purchaseReturnLines   PurchaseReturnLine[]
  supplierInvoices      SupplierInvoice[]
  posRegisters          PosRegister[]
  posShifts             PosShift[]
  posCashMovements      PosCashMovement[]
  posSales              PosSale[]
  posReturns            PosReturn[]
  storefronts           Storefront[]
  storefrontProducts    StorefrontProduct[]
  carts                 Cart[]
  cartLines             CartLine[]
  commerceOrders        CommerceOrder[]

  @@map("tenants")
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  CLOSING
  CLOSED
}

/// Tenant-scoped link between a global User identity and a Tenant.
model Membership {
  id        String           @id @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(INVITED)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments RoleAssignment[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId, status])
  @@map("memberships")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

/// Administrative grouping inside a Tenant. It has no legal or accounting
/// semantics; those belong to Company.
model Organization {
  id        String             @id @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  code      String             @db.VarChar(50)
  name      String             @db.VarChar(200)
  status    OrganizationStatus @default(ACTIVE)
  version   Int                @default(1)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  companies Company[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("organizations")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

/// Legal/accounting or autonomous operating entity. The composite relation
/// to Organization makes a cross-tenant parent reference impossible in the DB.
model Company {
  id             String        @id @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  code           String        @db.VarChar(50)
  name           String        @db.VarChar(200)
  status         CompanyStatus @default(ACTIVE)
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organization          Organization           @relation(fields: [tenantId, organizationId], references: [tenantId, id], onDelete: Restrict)
  settingValues         SettingValue[]
  auditEntries          AuditEntry[]
  outboxMessages        OutboxMessage[]
  fileObjects           FileObject[]
  unitsOfMeasure        UnitOfMeasure[]
  categories            Category[]
  brands                Brand[]
  products              Product[]
  customers             Customer[]
  suppliers             Supplier[]
  taxes                 Tax[]
  warehouses            Warehouse[]
  priceLists            PriceList[]
  inventoryMovements    InventoryMovement[]
  inventoryBalances     InventoryBalance[]
  inventoryTransfers    InventoryTransfer[]
  inventoryReservations InventoryReservation[]
  quotes                Quote[]
  salesOrders           SalesOrder[]
  salesReturns          SalesReturn[]
  payments              Payment[]
  purchaseOrders        PurchaseOrder[]
  purchaseReceipts      PurchaseReceipt[]
  purchaseReturns       PurchaseReturn[]
  supplierInvoices      SupplierInvoice[]
  posRegisters          PosRegister[]
  posShifts             PosShift[]
  posCashMovements      PosCashMovement[]
  posSales              PosSale[]
  posReturns            PosReturn[]
  storefronts           Storefront[]
  commerceOrders        CommerceOrder[]
  carts                 Cart[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, organizationId])
  @@map("companies")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

/// Global, code-owned permission catalog (docs/MULTITENANCY.md §9.1).
/// Never created from the UI; seeded idempotently by PermissionCatalogSeeder.
model Permission {
  id          String   @id @db.Uuid
  key         String   @unique @db.VarChar(150)
  description String   @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// A tenant-owned, named group of permissions. Roles are custom per tenant;
/// `isSystem` marks the "Owner" role seeded at provisioning (docs/MULTITENANCY.md §9).
model Role {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(100)
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  assignments     RoleAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("roles")
}

/// Join table. Carries `tenantId` solely so the FK to Role can be the
/// composite (tenantId, id) pattern — Permission itself is global (docs/ARCHITECTURE.md §8.1).
model RolePermission {
  tenantId     String @map("tenant_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

enum RoleAssignmentScope {
  TENANT
  COMPANY
}

/// Grants a Role to a Membership within a scope (docs/MULTITENANCY.md §9.2).
/// BRANCH/WAREHOUSE scopes are deferred until those entities exist — accepting
/// a scopeId with nothing to validate it against would be an unenforced claim.
model RoleAssignment {
  id           String              @id @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  membershipId String              @map("membership_id") @db.Uuid
  roleId       String              @map("role_id") @db.Uuid
  scopeType    RoleAssignmentScope @map("scope_type")
  scopeId      String?             @map("scope_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@unique([membershipId, roleId, scopeType, scopeId])
  @@index([tenantId, membershipId])
  @@map("role_assignments")
}

enum ConfigScopeType {
  PLATFORM
  TENANT
  COMPANY
}

enum SettingDataType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

/// Global, code-owned configuration catalog (docs/ARCHITECTURE.md §8.2,
/// MASTER_SPEC §28). Never created from the UI; seeded idempotently by
/// SettingCatalogSeeder, same pattern as Permission.
model SettingDefinition {
  id            String            @id @db.Uuid
  key           String            @unique @db.VarChar(150)
  dataType      SettingDataType   @map("data_type")
  description   String            @db.VarChar(300)
  defaultValue  Json              @map("default_value")
  allowedScopes ConfigScopeType[] @map("allowed_scopes")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  values SettingValue[]

  @@map("setting_definitions")
}

/// A concrete value for a SettingDefinition at exactly one scope instance.
/// `tenantId`/`companyId` are nullable because PLATFORM-scope rows have
/// neither — Postgres skips a composite FK check entirely when any of its
/// columns is NULL, so the `company` relation below only ever applies to
/// COMPANY-scope rows. `scopeKey` is a denormalized, non-null discriminator
/// (`"platform"` / tenantId / `"tenantId:companyId"`) computed in application
/// code (see the domain entity) purely so the DB can enforce "one value per
/// definition per concrete scope instance" via a plain unique index — NULLs
/// in `tenantId`/`companyId` are distinct from each other in Postgres and
/// would not do this on their own.
model SettingValue {
  id           String          @id @db.Uuid
  definitionId String          @map("definition_id") @db.Uuid
  scopeType    ConfigScopeType @map("scope_type")
  tenantId     String?         @map("tenant_id") @db.Uuid
  companyId    String?         @map("company_id") @db.Uuid
  scopeKey     String          @map("scope_key") @db.VarChar(80)
  value        Json
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  definition SettingDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  tenant     Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company    Company?          @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)

  @@unique([definitionId, scopeType, scopeKey])
  @@index([tenantId])
  @@map("setting_values")
}

/// Per-user, per-key preference (docs/ARCHITECTURE.md §8.2). Global to the
/// User identity, not tenant-scoped — same reasoning as User itself
/// (docs/MULTITENANCY.md §4.8). Deliberately has no code-owned catalog like
/// SettingDefinition: preferences are personal/UI concerns (theme, page
/// size) that each feature can read/write directly without a central
/// registry.
model UserPreference {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  key       String   @db.VarChar(150)
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("user_preferences")
}

/// Append-only audit record (MASTER_SPEC §10). No application role has
/// UPDATE/DELETE on this table (docs/ARCHITECTURE.md §8.3) — the only
/// supported write is an insert via RecordAuditEntryUseCase. `userId` is
/// the actor, nullable for unauthenticated events (e.g. a failed login
/// attempt with no resolvable account). `tenantId`/`companyId` are null for
/// actions that are not tenant-scoped at all (Authentication, User status —
/// docs/MULTITENANCY.md §4.8), not merely "unknown".
model AuditEntry {
  id             String   @id @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  tenantId       String?  @map("tenant_id") @db.Uuid
  companyId      String?  @map("company_id") @db.Uuid
  action         String   @db.VarChar(150)
  resource       String   @db.VarChar(100)
  resourceId     String?  @map("resource_id") @db.Uuid
  previousValues Json?    @map("previous_values")
  newValues      Json?    @map("new_values")
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(512)
  correlationId  String   @map("correlation_id") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company? @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([correlationId])
  @@map("audit_entries")
}

enum OutboxMessageStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

/// Transactional outbox (docs/EVENTS.md §8). A row here is inserted in the
/// SAME database transaction as the state change it describes — this is the
/// one piece of this schema where that atomicity is a hard requirement, not
/// a documented best-effort gap (contrast with AuditEntry). `appendOutboxMessage`
/// (apps/api/src/core/events) is the only place that inserts here, and it
/// accepts whatever Prisma client the caller's own transaction is using —
/// producers append inside their own repository's `$transaction`, never
/// as a separate follow-up write.
model OutboxMessage {
  id               String              @id @db.Uuid
  tenantId         String?             @map("tenant_id") @db.Uuid
  companyId        String?             @map("company_id") @db.Uuid
  eventType        String              @map("event_type") @db.VarChar(150)
  eventVersion     Int                 @map("event_version")
  aggregateType    String              @map("aggregate_type") @db.VarChar(100)
  aggregateId      String              @map("aggregate_id") @db.Uuid
  aggregateVersion Int?                @map("aggregate_version")
  payload          Json
  occurredAt       DateTime            @map("occurred_at") @db.Timestamptz(6)
  availableAt      DateTime            @default(now()) @map("available_at") @db.Timestamptz(6)
  status           OutboxMessageStatus @default(PENDING)
  attemptCount     Int                 @default(0) @map("attempt_count")
  lastErrorCode    String?             @map("last_error_code") @db.VarChar(150)
  lockedAt         DateTime?           @map("locked_at") @db.Timestamptz(6)
  lockedBy         String?             @map("locked_by") @db.VarChar(100)
  publishedAt      DateTime?           @map("published_at") @db.Timestamptz(6)
  correlationId    String              @map("correlation_id") @db.VarChar(100)
  causationId      String?             @map("causation_id") @db.VarChar(100)
  actorType        String?             @map("actor_type") @db.VarChar(20)
  actorId          String?             @map("actor_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company? @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([status, availableAt])
  @@index([tenantId])
  @@map("outbox_messages")
}

/**
 * Consumer-side idempotency ledger (docs/EVENTS.md §9). One row per
 * (consumerName, messageId) pair — messageId is the outbox message's own id
 * (its eventId), so this is keyed on "which consumer has seen which event",
 * not on the event's own identity. Deliberately only two states, no
 * separate FAILED: a failed effect simply leaves the row in PROCESSING with
 * its lease intact, so it becomes reclaimable again once that lease
 * expires — the same recovery mechanism already used for crashed
 * dispatchers, not a second mechanism to reason about.
 */
model InboxMessage {
  id            String             @id @db.Uuid
  consumerName  String             @map("consumer_name") @db.VarChar(100)
  messageId     String             @map("message_id") @db.Uuid
  tenantId      String?            @map("tenant_id") @db.Uuid
  status        InboxMessageStatus @default(PROCESSING)
  attemptCount  Int                @default(0) @map("attempt_count")
  lastErrorCode String?            @map("last_error_code") @db.VarChar(150)
  lockedAt      DateTime           @map("locked_at") @db.Timestamptz(6)
  processedAt   DateTime?          @map("processed_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([consumerName, messageId])
  @@index([status, lockedAt])
  @@map("inbox_messages")
}

enum InboxMessageStatus {
  PROCESSING
  PROCESSED
}

enum FileObjectStatus {
  ACTIVE
  DELETED
  PURGED
}

/// File metadata + ownership record for objects held in S3-compatible
/// storage (MinIO locally, S3 in production — MASTER_SPEC §22). The bytes
/// themselves never touch this table or local disk: `storageKey` is only the
/// object key inside the configured bucket, and access happens exclusively
/// through short-lived signed download URLs issued after a tenant/ownership
/// check (docs/ARCHITECTURE.md §10, see FilesController). `status` is a
/// deliberate soft-delete: deleting a FileObject here does not synchronously
/// delete the underlying storage object. `PurgeDeletedFilesUseCase`
/// (FilePurgeScheduler) later deletes the real object past the retention
/// window and transitions the row to PURGED — the metadata row itself is
/// kept, never hard-deleted, so audit entries referencing this id keep
/// resolving.
model FileObject {
  id               String           @id @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  companyId        String?          @map("company_id") @db.Uuid
  ownerUserId      String           @map("owner_user_id") @db.Uuid
  storageKey       String           @unique @map("storage_key") @db.VarChar(500)
  originalFilename String           @map("original_filename") @db.VarChar(255)
  contentType      String           @map("content_type") @db.VarChar(150)
  sizeBytes        BigInt           @map("size_bytes")
  status           FileObjectStatus @default(ACTIVE)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)
  purgedAt         DateTime?        @map("purged_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company? @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  owner   User     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, companyId])
  @@index([status, deletedAt])
  @@map("file_objects")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationDeliveryStatus {
  SENT
  FAILED
}

/// A notification request (MASTER_SPEC §48). Any module can request one
/// without knowing the delivery provider — see RequestNotificationUseCase
/// (apps/api/src/core/notifications). No HTTP endpoint creates these
/// directly (would let any authenticated user spam another); it is only
/// reachable as an internal service call from another module, same pattern
/// as RecordAuditEntryUseCase.
model Notification {
  id              String   @id @db.Uuid
  tenantId        String?  @map("tenant_id") @db.Uuid
  recipientUserId String   @map("recipient_user_id") @db.Uuid
  type            String   @db.VarChar(150)
  title           String   @db.VarChar(200)
  body            String
  data            Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipient  User                   @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  deliveries NotificationDelivery[]

  @@index([tenantId, recipientUserId, createdAt])
  @@map("notifications")
}

/// One delivery attempt per channel requested for a Notification. V1 only
/// implements IN_APP (delivery = persistence, dispatched synchronously, so
/// a row is always born SENT or FAILED — no PENDING state exists yet).
/// EMAIL/SMS/WHATSAPP/PUSH are reserved channel values with no adapter
/// built — requesting one produces a FAILED row with an explanatory
/// `failure_reason`, same "reserved but unimplemented" pattern as
/// RoleAssignment's BRANCH/WAREHOUSE scopes.
model NotificationDelivery {
  id             String                     @id @db.Uuid
  notificationId String                     @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         NotificationDeliveryStatus
  sentAt         DateTime?                  @map("sent_at") @db.Timestamptz(6)
  readAt         DateTime?                  @map("read_at") @db.Timestamptz(6)
  failureReason  String?                    @map("failure_reason") @db.VarChar(300)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@map("notification_deliveries")
}

enum AppKind {
  BUSINESS_APP
  CHANNEL
  INTEGRATION
  INDUSTRY_EXTENSION
}

/// Global, code-owned catalog of official apps/modules (docs/PLUGINS.md,
/// docs/ARCHITECTURE.md §8.2). Never created from the UI; seeded
/// idempotently by AppCatalogSeeder, same pattern as Permission/
/// SettingDefinition. `key` is the manifest id (docs/PLUGINS.md §4.1:
/// stable, lowercase kebab-case, never reused) — `id` stays a surrogate
/// UUID so FKs follow this project's usual pattern, exactly like Permission.
/// `dependsOnKeys` references other rows' `key`, not `id` — the catalog is
/// defined in code before any UUID exists, so dependencies are naturally
/// expressed in terms of the stable keys (see AppCatalogSeeder).
model AppDefinition {
  id            String   @id @db.Uuid
  key           String   @unique @db.VarChar(60)
  name          String   @db.VarChar(150)
  version       String   @db.VarChar(30)
  kind          AppKind
  dependsOnKeys String[] @map("depends_on_keys")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenantApps TenantApp[]

  @@map("app_definitions")
}

enum TenantAppStatus {
  ENABLED
  DISABLED
}

/// Tenant-scoped enablement of an AppDefinition (docs/PLUGINS.md §3.5, §7).
/// V1 mínimo collapses the full AVAILABLE/INSTALLING/INSTALLED/ENABLING/
/// DISABLING/SUSPENDED lifecycle down to ENABLED/DISABLED: with no
/// entitlement/billing system yet (MASTER_SPEC §56) and no app-specific
/// routes/jobs to gate behind a transitional state, those extra states
/// would have no distinct real behavior — see docs/DECISIONS.md ADR-005.
model TenantApp {
  id              String          @id @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  appDefinitionId String          @map("app_definition_id") @db.Uuid
  status          TenantAppStatus
  enabledAt       DateTime        @map("enabled_at") @db.Timestamptz(6)
  disabledAt      DateTime?       @map("disabled_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appDefinition  AppDefinition      @relation(fields: [appDefinitionId], references: [id], onDelete: Restrict)
  configurations AppConfiguration[]

  @@unique([tenantId, appDefinitionId])
  @@index([tenantId])
  @@map("tenant_apps")
}

/// Opaque per-tenant-app JSON configuration (docs/PLUGINS.md §11.2). No
/// formal per-key catalog like SettingDefinition yet — no shipped app
/// declares any configurable setting today, so there is nothing real to
/// validate a schema against (see docs/DECISIONS.md ADR-005 "Deferred").
model AppConfiguration {
  id          String   @id @db.Uuid
  tenantAppId String   @map("tenant_app_id") @db.Uuid
  key         String   @db.VarChar(150)
  value       Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenantApp TenantApp @relation(fields: [tenantAppId], references: [id], onDelete: Cascade)

  @@unique([tenantAppId, key])
  @@map("app_configurations")
}

// ---------------------------------------------------------------------------
// Phase 2 — Master Data (docs/ARCHITECTURE.md §5.2). First business-owned
// tables: unlike Foundation, `company_id` here is NOT nullable — master data
// genuinely belongs to exactly one company (MASTER_SPEC §19: "Product puede
// pertenecer a company"), not an optional scope refinement. Money/quantity
// fields use `numeric` (never float, MASTER_SPEC §30/§82); the domain layer
// represents them as canonical decimal strings (see ProductProps) to avoid
// depending on Prisma's Decimal type outside infrastructure.
// ---------------------------------------------------------------------------

enum MasterDataStatus {
  ACTIVE
  INACTIVE
}

/// Code-owned master data, company-scoped (docs/MASTER_SPEC.md Fase 2).
model UnitOfMeasure {
  id        String           @id @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  companyId String           @map("company_id") @db.Uuid
  code      String           @db.VarChar(20)
  name      String           @db.VarChar(100)
  symbol    String           @db.VarChar(10)
  status    MasterDataStatus @default(ACTIVE)
  version   Int              @default(1)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company  Company   @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  products Product[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("units_of_measure")
}

/// Self-referencing tree (docs/MASTER_SPEC.md Fase 2). `parentId` uses the
/// same composite-FK-to-self pattern as other tenant-scoped self relations
/// in this schema — `@@unique([tenantId, id])` exists purely to let the
/// parent FK stay tenant-safe.
model Category {
  id        String           @id @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  companyId String           @map("company_id") @db.Uuid
  parentId  String?          @map("parent_id") @db.Uuid
  code      String           @db.VarChar(50)
  name      String           @db.VarChar(150)
  status    MasterDataStatus @default(ACTIVE)
  version   Int              @default(1)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company  Company    @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  parent   Category?  @relation("CategoryParent", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  children Category[] @relation("CategoryParent")
  products Product[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@index([tenantId, parentId])
  @@map("categories")
}

model Brand {
  id        String           @id @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  companyId String           @map("company_id") @db.Uuid
  code      String           @db.VarChar(50)
  name      String           @db.VarChar(150)
  status    MasterDataStatus @default(ACTIVE)
  version   Int              @default(1)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company  Company   @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  products Product[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("brands")
}

enum ProductType {
  PHYSICAL_GOOD
  SERVICE
  DIGITAL_PRODUCT
  RAW_MATERIAL
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

/// Kit/Bundle product types and lot/serial/expiration tracking
/// (MASTER_SPEC §19/§20) are deliberately out of scope for this first Master
/// Data pass — nothing in Foundation or this phase consumes them yet
/// (Inventory/Sales, Phase 3-4). `base_price`/`base_cost` are the product's
/// own price when `has_variants` is false; a variant's own price/cost
/// override these when `has_variants` is true. Multi-tier/customer-specific
/// Price Lists (docs/ARCHITECTURE.md §5.2 "Pricing") are also deferred —
/// see "Known limitations" in docs/SECURITY.md "Catalog".
model Product {
  id              String        @id @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  categoryId      String?       @map("category_id") @db.Uuid
  brandId         String?       @map("brand_id") @db.Uuid
  unitOfMeasureId String        @map("unit_of_measure_id") @db.Uuid
  code            String        @db.VarChar(50)
  name            String        @db.VarChar(200)
  description     String?
  type            ProductType   @default(PHYSICAL_GOOD)
  trackInventory  Boolean       @default(true) @map("track_inventory")
  sellable        Boolean       @default(true)
  purchasable     Boolean       @default(true)
  hasVariants     Boolean       @default(false) @map("has_variants")
  publishOnline   Boolean       @default(false) @map("publish_online")
  barcode         String?       @db.VarChar(64)
  basePrice       Decimal?      @map("base_price") @db.Decimal(14, 4)
  baseCost        Decimal?      @map("base_cost") @db.Decimal(14, 4)
  status          ProductStatus @default(ACTIVE)
  version         Int           @default(1)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company               Company                @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  category              Category?              @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  brand                 Brand?                 @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Restrict)
  unitOfMeasure         UnitOfMeasure          @relation(fields: [tenantId, unitOfMeasureId], references: [tenantId, id], onDelete: Restrict)
  variants              ProductVariant[]
  priceListItems        PriceListItem[]
  inventoryMovements    InventoryMovement[]
  inventoryBalances     InventoryBalance[]
  inventoryTransfers    InventoryTransfer[]
  inventoryReservations InventoryReservation[]
  salesOrderLines       SalesOrderLine[]
  quoteLines            QuoteLine[]
  purchaseOrderLines    PurchaseOrderLine[]
  storefrontProducts    StorefrontProduct[]
  cartLines             CartLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, code])
  @@unique([tenantId, companyId, barcode])
  @@index([tenantId, companyId])
  @@index([tenantId, categoryId])
  @@index([tenantId, brandId])
  @@map("products")
}

/// A sellable SKU for a `hasVariants` product (MASTER_SPEC §19: "Camisa →
/// Azul/S, Azul/M, ..."). `attributes` is JSONB deliberately — variant
/// dimensions (color, size, ...) are genuinely open-ended per product and a
/// normalized EAV schema would be premature with no second consumer yet
/// (docs/ARCHITECTURE.md §57).
model ProductVariant {
  id         String           @id @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  productId  String           @map("product_id") @db.Uuid
  sku        String           @db.VarChar(64)
  barcode    String?          @db.VarChar(64)
  attributes Json             @default("{}")
  price      Decimal          @db.Decimal(14, 4)
  cost       Decimal?         @db.Decimal(14, 4)
  status     MasterDataStatus @default(ACTIVE)
  version    Int              @default(1)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  inventoryMovements    InventoryMovement[]
  inventoryBalances     InventoryBalance[]
  inventoryTransfers    InventoryTransfer[]
  inventoryReservations InventoryReservation[]
  salesOrderLines       SalesOrderLine[]
  quoteLines            QuoteLine[]
  purchaseOrderLines    PurchaseOrderLine[]
  cartLines             CartLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@unique([tenantId, productId, attributes])
  @@index([tenantId, productId])
  @@map("product_variants")
}

/// Customer and Supplier are deliberately separate models, not a shared
/// "Party" abstraction, per docs/ROADMAP.md §6's explicit instruction to
/// decide this "solo si el análisis demuestra semántica común útil". Today
/// their fields are identical — but Phase 4 (Sales) will add
/// customer-only concepts (credit limit, price list assignment) and Phase 5
/// (Purchasing) will add supplier-only concepts (payment terms, lead time)
/// that have no natural home on a shared table without nullable columns
/// that only ever apply to one side. Duplicating this small field set now
/// is cheaper than un-sharing a Party model later once real business rules
/// depend on it (MASTER_SPEC §76's "don't design for hypothetical future
/// requirements" cuts the other way here — the sharing is the speculative
/// part, since only Master Data exists today and both sides already read
/// identically to real ERPs that treat them as one Party. This project's
/// convention is to under-abstract rather than over-abstract, so it stays
/// two models).
model Customer {
  id          String           @id @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  code        String           @db.VarChar(50)
  name        String           @db.VarChar(200)
  legalName   String?          @map("legal_name") @db.VarChar(200)
  taxId       String?          @map("tax_id") @db.VarChar(60)
  email       String?          @db.VarChar(200)
  phone       String?          @db.VarChar(40)
  addressLine String?          @map("address_line") @db.VarChar(255)
  city        String?          @db.VarChar(100)
  country     String?          @db.VarChar(2)
  status      MasterDataStatus @default(ACTIVE)
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)

  salesOrders    SalesOrder[]
  quotes         Quote[]
  commerceOrders CommerceOrder[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, code])
  @@unique([tenantId, companyId, taxId])
  @@index([tenantId, companyId])
  @@map("customers")
}

model Supplier {
  id          String           @id @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  code        String           @db.VarChar(50)
  name        String           @db.VarChar(200)
  legalName   String?          @map("legal_name") @db.VarChar(200)
  taxId       String?          @map("tax_id") @db.VarChar(60)
  email       String?          @db.VarChar(200)
  phone       String?          @db.VarChar(40)
  addressLine String?          @map("address_line") @db.VarChar(255)
  city        String?          @db.VarChar(100)
  country     String?          @db.VarChar(2)
  status      MasterDataStatus @default(ACTIVE)
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)

  purchaseOrders   PurchaseOrder[]
  supplierInvoices SupplierInvoice[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, code])
  @@unique([tenantId, companyId, taxId])
  @@index([tenantId, companyId])
  @@map("suppliers")
}

/// Master-data tax rate lookup — a rate Products/Sales lines can reference
/// later (Phase 4). Deliberately not a rules engine: no jurisdiction logic,
/// no compound/cascading tax composition, no product-category applicability
/// rules (MASTER_SPEC §31 "Tax Engine desacoplado" is explicitly deferred —
/// see docs/SECURITY.md "Taxes"). `rate` is a percentage value (e.g.
/// "12.0000" means 12%), not a fraction.
model Tax {
  id        String           @id @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  companyId String           @map("company_id") @db.Uuid
  code      String           @db.VarChar(50)
  name      String           @db.VarChar(150)
  rate      Decimal          @db.Decimal(7, 4)
  status    MasterDataStatus @default(ACTIVE)
  version   Int              @default(1)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)

  salesOrderLines SalesOrderLine[]
  quoteLines      QuoteLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("taxes")
}

/// Master-data warehouse lookup. `docs/ARCHITECTURE.md` §6's conceptual
/// model allows an optional Branch/Location association, but neither Branch
/// nor Location exist as entities anywhere in this schema yet — adding
/// nullable FKs to tables that don't exist would be pure speculative
/// scaffolding (MASTER_SPEC §59/§93). Warehouse belongs directly to Company
/// for this slice; a Branch/Location association can be added additively
/// once either entity is actually built.
model Warehouse {
  id          String           @id @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  code        String           @db.VarChar(50)
  name        String           @db.VarChar(150)
  addressLine String?          @map("address_line") @db.VarChar(255)
  city        String?          @db.VarChar(100)
  country     String?          @db.VarChar(2)
  status      MasterDataStatus @default(ACTIVE)
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)

  inventoryMovements     InventoryMovement[]
  inventoryBalances      InventoryBalance[]
  transfersAsSource      InventoryTransfer[]    @relation("TransferSource")
  transfersAsDestination InventoryTransfer[]    @relation("TransferDestination")
  inventoryReservations  InventoryReservation[]
  salesOrderLines        SalesOrderLine[]
  purchaseOrderLines     PurchaseOrderLine[]
  posRegisters           PosRegister[]
  storefronts            Storefront[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("warehouses")
}

/// A named price scheme with an optional validity window (`docs/ROADMAP.md`
/// §6 item 4, "Pricing/Price Lists con Decimal y vigencia"). Resolving which
/// price list applies to a given sale on a given date is Sales-phase
/// business logic (Phase 4) — this module only stores the lists and their
/// line items, the same "storage now, business rules later" split already
/// used for Typed Configuration in Foundation.
model PriceList {
  id         String           @id @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  companyId  String           @map("company_id") @db.Uuid
  code       String           @db.VarChar(50)
  name       String           @db.VarChar(150)
  currency   String           @db.VarChar(3)
  validFrom  DateTime?        @map("valid_from") @db.Date
  validUntil DateTime?        @map("valid_until") @db.Date
  status     MasterDataStatus @default(ACTIVE)
  version    Int              @default(1)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company         @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  items   PriceListItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("price_lists")
}

/// One product's price within a PriceList. Deliberately references `Product`
/// only, not `ProductVariant` — supporting per-variant list pricing would
/// need a nullable-FK uniqueness scheme (a partial unique index Prisma
/// cannot express declaratively) for no validated use case yet. A
/// `hasVariants` product simply cannot be added to a price list in this
/// slice — see docs/SECURITY.md "Pricing" for the full reasoning. Hard
/// `DELETE` (not a status toggle) is correct here: a price list line has no
/// lifecycle of its own the way a standalone master-data entity does.
model PriceListItem {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  priceListId String   @map("price_list_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  price       Decimal  @db.Decimal(14, 4)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  priceList PriceList @relation(fields: [tenantId, priceListId], references: [tenantId, id], onDelete: Cascade)
  product   Product   @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, priceListId, productId])
  @@index([tenantId, priceListId])
  @@index([tenantId, productId])
  @@map("price_list_items")
}

// ---------------------------------------------------------------------------
// Inventory (Phase 3, docs/ROADMAP.md §7). A sellable unit is either a
// `Product` (when `hasVariants` is false) or a `ProductVariant` (when true) —
// `productVariantId` is nullable and its presence/absence is validated
// against the real product at the application layer (the same cross-module
// `GetProductUseCase`/`GetProductVariantUseCase` pattern established for
// Pricing). Deliberately out of scope for this slice, per "solo según
// alcance aprobado" in docs/ROADMAP.md §7: warehouse locations/bins and
// lot/serial/expiration tracking — see docs/SECURITY.md "Inventory".
// ---------------------------------------------------------------------------

enum InventoryMovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  TRANSFER_CANCELLED
  RESERVATION
  RELEASE
  RETURN
}

enum InventoryMovementReferenceType {
  TRANSFER
  RESERVATION
  MANUAL
  SALES_ORDER
  SALES_RETURN
  PURCHASE_ORDER
  PURCHASE_RETURN
}

/// Append-only ledger — the single source of truth for every balance change
/// (docs/ROADMAP.md §7 exit criteria: "Cada cambio de saldo tiene ledger y
/// reconciliación"). Never updated or deleted; a mistake is corrected by
/// posting a new compensating movement, never by editing history
/// ("Reversal en vez de editar/eliminar movimientos"). `quantity` is signed
/// — its sign is validated against `type` at the domain layer (e.g. `ISSUE`
/// must be negative, `RECEIPT` must be positive), so the on-hand/reserved
/// delta for a given balance row is always exactly `SUM(quantity)` over the
/// relevant rows, with no separate direction column to keep in sync.
model InventoryMovement {
  id               String                          @id @db.Uuid
  tenantId         String                          @map("tenant_id") @db.Uuid
  companyId        String                          @map("company_id") @db.Uuid
  warehouseId      String                          @map("warehouse_id") @db.Uuid
  productId        String                          @map("product_id") @db.Uuid
  productVariantId String?                         @map("product_variant_id") @db.Uuid
  type             InventoryMovementType
  quantity         Decimal                         @db.Decimal(14, 4)
  reason           String?                         @db.VarChar(500)
  referenceType    InventoryMovementReferenceType? @map("reference_type")
  referenceId      String?                         @map("reference_id") @db.Uuid
  correlationId    String                          @map("correlation_id") @db.VarChar(100)
  createdByUserId  String                          @map("created_by_user_id") @db.Uuid
  createdAt        DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company        Company         @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  warehouse      Warehouse       @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  product        Product         @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  productVariant ProductVariant? @relation(fields: [tenantId, productVariantId], references: [tenantId, id], onDelete: Restrict)
  createdBy      User            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, companyId, warehouseId, productId, productVariantId])
  @@index([tenantId, referenceType, referenceId])
  @@map("inventory_movements")
}

/// A materialized, reconcilable projection — never the source of truth
/// (`InventoryMovement` is). `onHandQuantity`/`reservedQuantity` are kept in
/// sync transactionally alongside every `InventoryMovement` insert via a
/// row-locked read-check-write (same `SELECT ... FOR UPDATE` pattern already
/// used by the outbox dispatcher's claim mechanism), and can always be
/// recomputed from scratch by summing the ledger for the same
/// (tenant, warehouse, product, variant) — that recomputation is the
/// reconciliation story this table's own correctness rests on.
/// `available = onHandQuantity - reservedQuantity` is a computed value in
/// the API response, never stored redundantly. There is no `inTransit`
/// column — an in-transit quantity is simply the sum of `InventoryTransfer`
/// rows in `IN_TRANSIT` status for the relevant source warehouse, a query
/// concept rather than a third balance bucket to keep synchronized.
model InventoryBalance {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  warehouseId      String   @map("warehouse_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  productVariantId String?  @map("product_variant_id") @db.Uuid
  onHandQuantity   Decimal  @default(0) @map("on_hand_quantity") @db.Decimal(14, 4)
  reservedQuantity Decimal  @default(0) @map("reserved_quantity") @db.Decimal(14, 4)
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company        Company         @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  warehouse      Warehouse       @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  product        Product         @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  productVariant ProductVariant? @relation(fields: [tenantId, productVariantId], references: [tenantId, id], onDelete: Restrict)

  // NOTE: the real "at most one balance row per sellable unit per warehouse"
  // constraint is enforced by two hand-added partial unique indexes in this
  // model's migration (Prisma cannot express a `WHERE` clause on `@@unique`
  // declaratively) — see docs/DATABASE.md "Inventory tables".
  @@index([tenantId, companyId, warehouseId])
  @@index([tenantId, productId])
  @@map("inventory_balances")
}

enum InventoryTransferStatus {
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

/// A transfer between two warehouses with **explicit state**
/// (docs/ROADMAP.md §7). Creating one immediately posts a `TRANSFER_OUT`
/// movement at the source warehouse (stock leaves on-hand there right away —
/// this is what makes it meaningfully "in transit"); completing it posts a
/// `TRANSFER_IN` at the destination; cancelling it while `IN_TRANSIT` posts a
/// `TRANSFER_CANCELLED` back at the source, never edits the original
/// `TRANSFER_OUT` row.
model InventoryTransfer {
  id                     String                  @id @db.Uuid
  tenantId               String                  @map("tenant_id") @db.Uuid
  companyId              String                  @map("company_id") @db.Uuid
  productId              String                  @map("product_id") @db.Uuid
  productVariantId       String?                 @map("product_variant_id") @db.Uuid
  sourceWarehouseId      String                  @map("source_warehouse_id") @db.Uuid
  destinationWarehouseId String                  @map("destination_warehouse_id") @db.Uuid
  quantity               Decimal                 @db.Decimal(14, 4)
  status                 InventoryTransferStatus @default(IN_TRANSIT)
  version                Int                     @default(1)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt            DateTime?               @map("completed_at") @db.Timestamptz(6)
  cancelledAt            DateTime?               @map("cancelled_at") @db.Timestamptz(6)

  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company              Company         @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  product              Product         @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  productVariant       ProductVariant? @relation(fields: [tenantId, productVariantId], references: [tenantId, id], onDelete: Restrict)
  sourceWarehouse      Warehouse       @relation("TransferSource", fields: [tenantId, sourceWarehouseId], references: [tenantId, id], onDelete: Restrict)
  destinationWarehouse Warehouse       @relation("TransferDestination", fields: [tenantId, destinationWarehouseId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, companyId, status])
  @@index([tenantId, sourceWarehouseId, status])
  @@map("inventory_transfers")
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
}

/// Earmarks on-hand stock as unavailable for new promises without physically
/// moving it — `RESERVATION`/`RELEASE` affect `InventoryBalance.reservedQuantity`,
/// never `onHandQuantity`. `referenceType`/`referenceId` stayed free-form
/// (unlike `InventoryMovement`'s closed enum) even after Sales (Phase 4)
/// became this table's first real consumer (`ConfirmSalesOrderUseCase`
/// passes `referenceType: "SALES_ORDER"` as a plain string, not an enum
/// value) — a genuine FK would need to point at whichever module reserves
/// stock, and POS (Phase 6) is expected to become a second, independent
/// one; a free string avoids re-widening this column's type every time a
/// new caller module appears.
model InventoryReservation {
  id               String                     @id @db.Uuid
  tenantId         String                     @map("tenant_id") @db.Uuid
  companyId        String                     @map("company_id") @db.Uuid
  warehouseId      String                     @map("warehouse_id") @db.Uuid
  productId        String                     @map("product_id") @db.Uuid
  productVariantId String?                    @map("product_variant_id") @db.Uuid
  quantity         Decimal                    @db.Decimal(14, 4)
  status           InventoryReservationStatus @default(ACTIVE)
  referenceType    String?                    @map("reference_type") @db.VarChar(50)
  referenceId      String?                    @map("reference_id") @db.VarChar(100)
  version          Int                        @default(1)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  releasedAt       DateTime?                  @map("released_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company        Company         @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  warehouse      Warehouse       @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  product        Product         @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  productVariant ProductVariant? @relation(fields: [tenantId, productVariantId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, companyId, warehouseId, status])
  @@index([tenantId, productId, status])
  @@map("inventory_reservations")
}

// ---------------------------------------------------------------------------
// Sales (Phase 4A, docs/ROADMAP.md §8). Quote/SalesOrder/SalesReturn are
// deliberately separate from Invoice (MASTER_SPEC §21: "no asumir que una
// venta equivale automáticamente a una factura") — Invoice is not built in
// this slice at all. Every line snapshots its own unitPrice/discountAmount/
// taxRate/lineTotal at creation time; nothing here re-reads live Catalog
// prices or Pricing price lists later, so a later price change never
// retroactively changes a historical order. Deliberately out of scope, per
// "solo según alcance aprobado": human-readable order/quote numbers
// (MASTER_SPEC §34 explicitly frames these as optional — "puede existir" —
// and a genuinely safe generator needs the same bounded-retry-on-conflict
// machinery already proven for `inventory_balances`' partial unique
// indexes; deferred rather than built half-safe), PENDING/PROCESSING/
// PARTIALLY_FULFILLED order states (MASTER_SPEC §21 lists them, but this
// slice has no per-line fulfillment tracking to make them real — see
// docs/SECURITY.md "Sales"), and Invoice itself.
// ---------------------------------------------------------------------------

enum SalesChannel {
  ERP
  POS
  ECOMMERCE
  B2B
  MARKETPLACE
  MOBILE
  API
}

enum QuoteStatus {
  DRAFT
  CONVERTED
  CANCELLED
}

/// A non-binding proposal with its own pricing snapshot, convertible into a
/// real SalesOrder (`ConvertQuoteToSalesOrderUseCase`). Never reserves
/// inventory — only a confirmed SalesOrder does.
model Quote {
  id          String       @id @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  customerId  String       @map("customer_id") @db.Uuid
  channel     SalesChannel @default(ERP)
  status      QuoteStatus  @default(DRAFT)
  currency    String       @db.VarChar(3)
  notes       String?      @db.VarChar(1000)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  convertedAt DateTime?    @map("converted_at") @db.Timestamptz(6)
  cancelledAt DateTime?    @map("cancelled_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company     Company      @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  customer    Customer     @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  lines       QuoteLine[]
  salesOrders SalesOrder[]

  @@unique([tenantId, id])
  @@index([tenantId, companyId, status])
  @@map("quotes")
}

/// Pricing snapshot at the moment the line was added — `unitPrice`/
/// `discountAmount`/`taxRate`/`lineTotal` never change afterward, even if
/// converted into a SalesOrder (the SalesOrderLine gets its own fresh copy).
model QuoteLine {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  quoteId          String   @map("quote_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  productVariantId String?  @map("product_variant_id") @db.Uuid
  taxId            String?  @map("tax_id") @db.Uuid
  quantity         Decimal  @db.Decimal(14, 4)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(14, 4)
  discountAmount   Decimal  @default(0) @map("discount_amount") @db.Decimal(14, 4)
  taxRate          Decimal  @default(0) @map("tax_rate") @db.Decimal(7, 4)
  lineTotal        Decimal  @map("line_total") @db.Decimal(14, 4)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  quote          Quote           @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Cascade)
  product        Product         @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  productVariant ProductVariant? @relation(fields: [tenantId, productVariantId], references: [tenantId, id], onDelete: Restrict)
  tax            Tax?            @relation(fields: [tenantId, taxId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, quoteId])
  @@map("quote_lines")
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  CANCELLED
}

/// `DRAFT -> CONFIRMED -> FULFILLED`, with `CANCELLED` reachable from
/// `DRAFT`/`CONFIRMED` only (never after `FULFILLED` — a fulfilled order is
/// corrected via a SalesReturn, not a cancellation). No `REFUNDED` status
/// here: a return doesn't retroactively change what was shipped, it is its
/// own record (`SalesReturn`) — see that model's docstring. Confirming
/// reserves inventory for every line through Inventory's own public
/// contract (`CreateReservationUseCase`); fulfilling releases those
/// reservations and issues real stock (`ReleaseReservationUseCase` +
/// `RecordIssueUseCase`, `referenceType: "SALES_ORDER"`).
model SalesOrder {
  id          String           @id @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  customerId  String           @map("customer_id") @db.Uuid
  quoteId     String?          @map("quote_id") @db.Uuid
  channel     SalesChannel     @default(ERP)
  status      SalesOrderStatus @default(DRAFT)
  currency    String           @db.VarChar(3)
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  confirmedAt DateTime?        @map("confirmed_at") @db.Timestamptz(6)
  fulfilledAt DateTime?        @map("fulfilled_at") @db.Timestamptz(6)
  cancelledAt DateTime?        @map("cancelled_at") @db.Timestamptz(6)

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company       Company          @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  customer      Customer         @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  quote         Quote?           @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Restrict)
  lines         SalesOrderLine[]
  returns       SalesReturn[]
  payments      Payment[]
  posSale       PosSale?
  commerceOrder CommerceOrder?

  @@unique([tenantId, id])
  @@index([tenantId, companyId, status])
  @@index([tenantId, customerId])
  @@map("sales_orders")
}

/// `warehouseId` is nullable — required only when the product tracks
/// inventory (validated at the application layer, the same conditional
/// requirement `productVariantId` already has based on `hasVariants`); a
/// service-type line with `trackInventory = false` never reserves stock at
/// all. `reservationId` is set once, on confirm, and never cleared — a
/// historical pointer to which `InventoryReservation` this line used, even
/// after it is released on fulfillment or cancellation.
model SalesOrderLine {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  salesOrderId     String   @map("sales_order_id") @db.Uuid
  warehouseId      String?  @map("warehouse_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  productVariantId String?  @map("product_variant_id") @db.Uuid
  taxId            String?  @map("tax_id") @db.Uuid
  quantity         Decimal  @db.Decimal(14, 4)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(14, 4)
  discountAmount   Decimal  @default(0) @map("discount_amount") @db.Decimal(14, 4)
  taxRate          Decimal  @default(0) @map("tax_rate") @db.Decimal(7, 4)
  lineTotal        Decimal  @map("line_total") @db.Decimal(14, 4)
  reservationId    String?  @map("reservation_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  salesOrder       SalesOrder        @relation(fields: [tenantId, salesOrderId], references: [tenantId, id], onDelete: Cascade)
  warehouse        Warehouse?        @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  product          Product           @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  productVariant   ProductVariant?   @relation(fields: [tenantId, productVariantId], references: [tenantId, id], onDelete: Restrict)
  tax              Tax?              @relation(fields: [tenantId, taxId], references: [tenantId, id], onDelete: Restrict)
  salesReturnLines SalesReturnLine[]

  @@unique([tenantId, id])
  @@index([tenantId, salesOrderId])
  @@map("sales_order_lines")
}

/// A return is its own record, not a SalesOrder status mutation (see
/// `SalesOrder`'s docstring) — a `FULFILLED` order stays `FULFILLED`
/// regardless of how many returns are later recorded against it.
/// `CreateSalesReturnUseCase` posts a real `RETURN` inventory movement per
/// line (`referenceType: "SALES_RETURN"`) and rejects returning more than
/// was ever fulfilled for a given `SalesOrderLine`, computed as a running
/// sum over `SalesReturnLine` — a ledger read, not a stored running total
/// that could drift (same philosophy as `InventoryBalance`).
model SalesReturn {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  salesOrderId String   @map("sales_order_id") @db.Uuid
  reason       String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company    Company           @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  salesOrder SalesOrder        @relation(fields: [tenantId, salesOrderId], references: [tenantId, id], onDelete: Restrict)
  lines      SalesReturnLine[]
  posReturn  PosReturn?

  @@unique([tenantId, id])
  @@index([tenantId, companyId])
  @@index([tenantId, salesOrderId])
  @@map("sales_returns")
}

model SalesReturnLine {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  salesReturnId    String   @map("sales_return_id") @db.Uuid
  salesOrderLineId String   @map("sales_order_line_id") @db.Uuid
  quantity         Decimal  @db.Decimal(14, 4)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  salesReturn    SalesReturn    @relation(fields: [tenantId, salesReturnId], references: [tenantId, id], onDelete: Cascade)
  salesOrderLine SalesOrderLine @relation(fields: [tenantId, salesOrderLineId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, salesReturnId])
  @@index([tenantId, salesOrderLineId])
  @@map("sales_return_lines")
}

// ---------------------------------------------------------------------------
// Payments (Phase 4B, docs/ROADMAP.md §8). Only adapters that need no
// external credentials are built for real in this slice — `CASH`/
// `BANK_TRANSFER`, both explicitly named as valid gateway adapters in
// MASTER_SPEC §22. A real `StripeAdapter`/`PayPalAdapter` needs live
// provider credentials this environment doesn't have; fabricating one that
// pretends to call a real provider would violate MASTER_SPEC §90 ("no
// simular integraciones o operaciones exitosas") far more seriously than
// any other adapter gap in this codebase, since it involves real money.
// `PaymentGateway` (the application-layer port) is designed so a real async
// adapter can be added later without touching this schema or the domain.
// Webhook signature verification and provider-timeout reconciliation
// (ROADMAP §8) are deferred with it — both are only meaningful once a real
// asynchronous gateway exists to receive a webhook from.
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  CAPTURED
  REFUNDED
  FAILED
}

/// `idempotencyKey` + the real `@@unique([tenantId, companyId, idempotencyKey])`
/// constraint is what satisfies "duplicar request no duplica... cargo"
/// (docs/ROADMAP.md §8 exit criteria) — retrying `CapturePaymentUseCase`
/// with the same key returns the already-captured `Payment` instead of
/// creating a second one, verified against a real Postgres unique
/// violation, not just an application-level check.
model Payment {
  id               String        @id @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  companyId        String        @map("company_id") @db.Uuid
  salesOrderId     String        @map("sales_order_id") @db.Uuid
  method           PaymentMethod
  status           PaymentStatus
  amount           Decimal       @db.Decimal(14, 4)
  currency         String        @db.VarChar(3)
  idempotencyKey   String        @map("idempotency_key") @db.VarChar(100)
  gatewayReference String?       @map("gateway_reference") @db.VarChar(200)
  failureReason    String?       @map("failure_reason") @db.VarChar(500)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  capturedAt       DateTime?     @map("captured_at") @db.Timestamptz(6)
  refundedAt       DateTime?     @map("refunded_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company       Company        @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  salesOrder    SalesOrder     @relation(fields: [tenantId, salesOrderId], references: [tenantId, id], onDelete: Restrict)
  posSale       PosSale?
  commerceOrder CommerceOrder?

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, idempotencyKey])
  @@index([tenantId, companyId, salesOrderId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Purchasing (Phase 5, docs/ROADMAP.md §9). PurchaseOrder/PurchaseOrderLine
// mirror SalesOrder/SalesOrderLine's shape closely, minus discount/tax
// (a supplier's own tax breakdown belongs on SupplierInvoice, a separate
// document — see that model's docstring). Unlike Sales, receiving is
// deliberately partial-first-class: PurchaseReceipt/PurchaseReceiptLine can
// be posted multiple times against the same CONFIRMED order, each validated
// against a running sum over prior receipts, never a stored counter — same
// ledger philosophy as SalesReturn. PurchaseReturn/PurchaseReturnLine record
// goods physically going back to the supplier (a real ISSUE movement, not a
// RETURN — see InventoryMovement's own reference-type docstring), validated
// against received-minus-already-returned, also a running-sum ledger read.
// ---------------------------------------------------------------------------

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  CLOSED
  CANCELLED
}

/// `DRAFT -> CONFIRMED -> CLOSED`, with `CANCELLED` reachable only from
/// `DRAFT`/`CONFIRMED` (docs/ROADMAP.md §9 "Returns y estados de cierre").
/// Confirming requires the `purchasing.orders.approve` permission,
/// deliberately distinct from `purchasing.orders.manage` (create/add-line/
/// close/cancel) — the segregation-of-duties exit criterion. Closing does
/// not require every line to be fully received: a business may legitimately
/// close an order with a permanent shortfall. `CancelPurchaseOrderUseCase`
/// additionally rejects cancelling a `CONFIRMED` order that already has at
/// least one `PurchaseReceipt` — goods that physically arrived cannot be
/// un-arrived by cancelling the paperwork.
model PurchaseOrder {
  id          String              @id @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  companyId   String              @map("company_id") @db.Uuid
  supplierId  String              @map("supplier_id") @db.Uuid
  status      PurchaseOrderStatus @default(DRAFT)
  currency    String              @db.VarChar(3)
  notes       String?             @db.VarChar(1000)
  version     Int                 @default(1)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  confirmedAt DateTime?           @map("confirmed_at") @db.Timestamptz(6)
  closedAt    DateTime?           @map("closed_at") @db.Timestamptz(6)
  cancelledAt DateTime?           @map("cancelled_at") @db.Timestamptz(6)

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company          Company             @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  supplier         Supplier            @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  lines            PurchaseOrderLine[]
  receipts         PurchaseReceipt[]
  returns          PurchaseReturn[]
  supplierInvoices SupplierInvoice[]

  @@unique([tenantId, id])
  @@index([tenantId, companyId, status])
  @@index([tenantId, supplierId])
  @@map("purchase_orders")
}

/// `warehouseId` is nullable — required only when the product tracks
/// inventory, same conditional rule `SalesOrderLine.warehouseId` already
/// established. `lineTotal = quantity × unitCost`, no discount/tax on this
/// line — a supplier's own tax breakdown belongs on `SupplierInvoice`.
model PurchaseOrderLine {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  purchaseOrderId  String   @map("purchase_order_id") @db.Uuid
  warehouseId      String?  @map("warehouse_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  productVariantId String?  @map("product_variant_id") @db.Uuid
  quantity         Decimal  @db.Decimal(14, 4)
  unitCost         Decimal  @map("unit_cost") @db.Decimal(14, 4)
  lineTotal        Decimal  @map("line_total") @db.Decimal(14, 4)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseOrder        PurchaseOrder         @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Cascade)
  warehouse            Warehouse?            @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  product              Product               @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  productVariant       ProductVariant?       @relation(fields: [tenantId, productVariantId], references: [tenantId, id], onDelete: Restrict)
  purchaseReceiptLines PurchaseReceiptLine[]
  purchaseReturnLines  PurchaseReturnLine[]

  @@unique([tenantId, id])
  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_lines")
}

/// A receipt is its own append-only record, not a `PurchaseOrder` status
/// mutation — a `CONFIRMED` order stays `CONFIRMED` regardless of how many
/// partial receipts are recorded against it; the order only advances to
/// `CLOSED` via an explicit close action. `CreatePurchaseReceiptUseCase`
/// posts a real `RECEIPT` inventory movement per line
/// (`referenceType: "PURCHASE_ORDER"`) and rejects receiving more than was
/// ever ordered for a given `PurchaseOrderLine`, computed as a running sum
/// over `PurchaseReceiptLine` — a ledger read, not a stored running total.
model PurchaseReceipt {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  notes           String?  @db.VarChar(1000)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company       Company               @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  purchaseOrder PurchaseOrder         @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Restrict)
  lines         PurchaseReceiptLine[]

  @@unique([tenantId, id])
  @@index([tenantId, companyId])
  @@index([tenantId, purchaseOrderId])
  @@map("purchase_receipts")
}

model PurchaseReceiptLine {
  id                  String   @id @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  purchaseReceiptId   String   @map("purchase_receipt_id") @db.Uuid
  purchaseOrderLineId String   @map("purchase_order_line_id") @db.Uuid
  quantity            Decimal  @db.Decimal(14, 4)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseReceipt   PurchaseReceipt   @relation(fields: [tenantId, purchaseReceiptId], references: [tenantId, id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [tenantId, purchaseOrderLineId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, purchaseReceiptId])
  @@index([tenantId, purchaseOrderLineId])
  @@map("purchase_receipt_lines")
}

/// A return is its own append-only record, not a `PurchaseOrder`/
/// `PurchaseReceipt` status mutation — same philosophy as `SalesReturn`.
/// `CreatePurchaseReturnUseCase` posts a real `ISSUE` inventory movement per
/// line (`referenceType: "PURCHASE_RETURN"`, goods physically leaving back
/// to the supplier) and rejects returning more than was ever received minus
/// what was already returned for a given `PurchaseOrderLine`.
model PurchaseReturn {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  reason          String?  @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company       Company              @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  purchaseOrder PurchaseOrder        @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Restrict)
  lines         PurchaseReturnLine[]

  @@unique([tenantId, id])
  @@index([tenantId, companyId])
  @@index([tenantId, purchaseOrderId])
  @@map("purchase_returns")
}

model PurchaseReturnLine {
  id                  String   @id @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  purchaseReturnId    String   @map("purchase_return_id") @db.Uuid
  purchaseOrderLineId String   @map("purchase_order_line_id") @db.Uuid
  quantity            Decimal  @db.Decimal(14, 4)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseReturn    PurchaseReturn    @relation(fields: [tenantId, purchaseReturnId], references: [tenantId, id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [tenantId, purchaseOrderLineId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, purchaseReturnId])
  @@index([tenantId, purchaseOrderLineId])
  @@map("purchase_return_lines")
}

enum SupplierInvoiceStatus {
  RECORDED
  CANCELLED
}

/// A supplier's own invoice, recorded as its own document
/// (docs/ROADMAP.md §9: "Supplier invoices como documento separado") —
/// never a `PurchaseOrder` field. Deliberately **not** connected to any
/// payment capture: this codebase's `Payment` model (Phase 4B) only ever
/// captures money coming *in* against a `SalesOrder`; a real
/// accounts-payable/outgoing payment flow is a distinct, unbuilt capability
/// (same "don't simulate" principle ADR-009 already applied to Payments —
/// `status` only ever tracks whether the invoice document itself is live,
/// `RECORDED -> CANCELLED`, never whether it was ever actually paid).
/// `amount` is not validated against the sum of the order's lines or its
/// receipts — a real supplier invoice can legitimately include freight,
/// adjustments, or partial-shipment amounts that don't equal any subset of
/// `PurchaseOrderLine.lineTotal`.
model SupplierInvoice {
  id              String                @id @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  companyId       String                @map("company_id") @db.Uuid
  supplierId      String                @map("supplier_id") @db.Uuid
  purchaseOrderId String                @map("purchase_order_id") @db.Uuid
  invoiceNumber   String                @map("invoice_number") @db.VarChar(100)
  amount          Decimal               @db.Decimal(14, 4)
  currency        String                @db.VarChar(3)
  issueDate       DateTime              @map("issue_date") @db.Date
  dueDate         DateTime?             @map("due_date") @db.Date
  status          SupplierInvoiceStatus @default(RECORDED)
  notes           String?               @db.VarChar(1000)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  cancelledAt     DateTime?             @map("cancelled_at") @db.Timestamptz(6)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company       Company       @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  supplier      Supplier      @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  purchaseOrder PurchaseOrder @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, companyId])
  @@index([tenantId, supplierId])
  @@index([tenantId, purchaseOrderId])
  @@map("supplier_invoices")
}

// ---------------------------------------------------------------------------
// POS (Phase 6, docs/ROADMAP.md §10). A register/shift/cash-movement domain
// of its own, integrated with Sales/Payments/Inventory purely through their
// public contracts (docs/ARCHITECTURE.md §6) — RingUpSaleUseCase creates a
// real SalesOrder (channel POS) and captures a real Payment exactly as the
// ERP Sales screen would, never a parallel/shortcut write path. No hardware
// adapter tables here: MASTER_SPEC §24 and this phase's own "Restricción"
// explicitly defer barcode-scanner/thermal-printer/cash-drawer adapters
// until real hardware exists to validate against — the same "don't simulate
// an integration nobody can verify" principle ADR-009 already applied to
// credentialed payment gateways. A USB barcode scanner behaves as a plain
// keyboard (HID) and needs no server-side code at all; ticket printing uses
// the browser's native print, not a fabricated thermal-printer SDK.
// ---------------------------------------------------------------------------

enum PosShiftStatus {
  OPEN
  CLOSED
}

enum PosCashMovementType {
  CASH_IN
  CASH_OUT
}

/// A physical/logical POS terminal, always tied to one `Warehouse` — every
/// sale rung up on this register issues stock from that warehouse
/// (`RingUpSaleUseCase` fills `AddSalesOrderLineUseCase.warehouseId` with
/// it). `MasterDataStatus` reused from Catalog/Warehouses/Taxes — the same
/// `ACTIVE`/`INACTIVE` shape, no register-specific states needed.
model PosRegister {
  id          String           @id @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  warehouseId String           @map("warehouse_id") @db.Uuid
  code        String           @db.VarChar(50)
  name        String           @db.VarChar(150)
  status      MasterDataStatus @default(ACTIVE)
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company   Company    @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  warehouse Warehouse  @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  shifts    PosShift[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("pos_registers")
}

/// `OPEN -> CLOSED`, terminal — a register may have at most one `OPEN`
/// shift at a time, enforced by `OpenShiftUseCase` querying for one first
/// (an application-level check, same style already used for
/// `PurchaseOrderHasReceiptsError` — no partial unique index for this).
/// `closingCashExpected`/`cashVariance` are computed exactly once, at close
/// time, by `CloseShiftUseCase` — `openingCash` plus this shift's
/// `PosCashMovement`s plus this shift's CASH `PosSale`s minus this shift's
/// CASH `PosReturn` refunds — and never recomputed afterwards: a closed
/// shift's numbers are a historical fact, the same "snapshot, don't
/// silently recompute" reasoning `SalesOrderLine.unitPrice` already
/// established.
model PosShift {
  id                  String         @id @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  companyId           String         @map("company_id") @db.Uuid
  registerId          String         @map("register_id") @db.Uuid
  status              PosShiftStatus @default(OPEN)
  openedByUserId      String         @map("opened_by_user_id") @db.Uuid
  openedAt            DateTime       @default(now()) @map("opened_at") @db.Timestamptz(6)
  openingCash         Decimal        @map("opening_cash") @db.Decimal(14, 4)
  closedByUserId      String?        @map("closed_by_user_id") @db.Uuid
  closedAt            DateTime?      @map("closed_at") @db.Timestamptz(6)
  closingCashCounted  Decimal?       @map("closing_cash_counted") @db.Decimal(14, 4)
  closingCashExpected Decimal?       @map("closing_cash_expected") @db.Decimal(14, 4)
  cashVariance        Decimal?       @map("cash_variance") @db.Decimal(14, 4)
  notes               String?        @db.VarChar(500)

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company       Company           @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  register      PosRegister       @relation(fields: [tenantId, registerId], references: [tenantId, id], onDelete: Restrict)
  openedBy      User              @relation("PosShiftsOpened", fields: [openedByUserId], references: [id], onDelete: Restrict)
  closedBy      User?             @relation("PosShiftsClosed", fields: [closedByUserId], references: [id], onDelete: Restrict)
  cashMovements PosCashMovement[]
  sales         PosSale[]
  returns       PosReturn[]

  @@unique([tenantId, id])
  @@index([tenantId, companyId, registerId, status])
  @@map("pos_shifts")
}

/// Append-only cash-drawer ledger entry — never updated/deleted, the same
/// philosophy as `InventoryMovement`/`AuditEntry`. Only meaningful while its
/// shift is `OPEN`; `RecordCashMovementUseCase` rejects one against a
/// `CLOSED` shift.
model PosCashMovement {
  id               String              @id @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  companyId        String              @map("company_id") @db.Uuid
  shiftId          String              @map("shift_id") @db.Uuid
  type             PosCashMovementType
  amount           Decimal             @db.Decimal(14, 4)
  reason           String              @db.VarChar(500)
  recordedByUserId String              @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company    Company  @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  shift      PosShift @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict)
  recordedBy User     @relation("PosCashMovementsRecorded", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, shiftId])
  @@map("pos_cash_movements")
}

/// The POS-owned record of a completed sale — created only after the real
/// `SalesOrder` (channel `POS`) is confirmed and fulfilled and its
/// `Payment` is `CAPTURED`; nothing is persisted here for an attempt that
/// fails partway (`RingUpSaleUseCase` compensates by cancelling the order
/// instead, the same pattern `ConfirmSalesOrderUseCase` already
/// established). `paymentMethod`/`amount` are snapshotted from the real
/// `Payment` at creation time so `CloseShiftUseCase` can sum a shift's cash
/// sales with one indexed query instead of joining out to `Payment` per row
/// — the same "snapshot a fact that must never silently drift" reasoning
/// `SalesOrderLine.unitPrice` already established. `idempotencyKey` plus
/// the real `@@unique([tenantId, companyId, idempotencyKey])` constraint is
/// what satisfies this phase's exit criterion ("Reintentos de terminal no
/// duplican ventas/pagos") for the common case — a retried ring-up with the
/// same key returns the already-completed sale instead of creating a
/// second `SalesOrder`/`Payment` — see `RingUpSaleUseCase`'s own docstring
/// for the residual concurrency window this shares with
/// `CapturePaymentUseCase` (docs/DECISIONS.md ADR-008's same accepted
/// "narrow crash window, not full exactly-once" reasoning).
model PosSale {
  id             String        @id @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  shiftId        String        @map("shift_id") @db.Uuid
  salesOrderId   String        @map("sales_order_id") @db.Uuid
  paymentId      String        @map("payment_id") @db.Uuid
  idempotencyKey String        @map("idempotency_key") @db.VarChar(100)
  paymentMethod  PaymentMethod @map("payment_method")
  amount         Decimal       @db.Decimal(14, 4)
  amountTendered Decimal?      @map("amount_tendered") @db.Decimal(14, 4)
  changeDue      Decimal?      @map("change_due") @db.Decimal(14, 4)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company    Company     @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  shift      PosShift    @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict)
  salesOrder SalesOrder  @relation(fields: [tenantId, salesOrderId], references: [tenantId, id], onDelete: Restrict)
  payment    Payment     @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)
  returns    PosReturn[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, idempotencyKey])
  @@unique([tenantId, salesOrderId])
  @@unique([tenantId, paymentId])
  @@index([tenantId, companyId, shiftId])
  @@map("pos_sales")
}

/// The POS-owned record of a completed return — mirrors `PosSale`: created
/// only after the real `SalesReturn` (and, if `refunded`, the real
/// `RefundPaymentUseCase` call against the original sale's `Payment`)
/// succeed. A refund is always the *original* payment's full amount — this
/// codebase has no partial-refund capability yet (ADR-009) — so at most one
/// `PosReturn` per `PosSale` can ever set `refunded = true`; a second return
/// against the same sale can still record goods coming back
/// (`refunded = false`) without attempting to refund an already-`REFUNDED`
/// payment. `refundAmount`/`refundMethod` are snapshotted from the payment
/// at refund time, for the same shift-close-math reason `PosSale.amount` is.
model PosReturn {
  id             String         @id @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  shiftId        String         @map("shift_id") @db.Uuid
  posSaleId      String         @map("pos_sale_id") @db.Uuid
  salesReturnId  String         @map("sales_return_id") @db.Uuid
  idempotencyKey String         @map("idempotency_key") @db.VarChar(100)
  refunded       Boolean        @default(false)
  refundAmount   Decimal?       @map("refund_amount") @db.Decimal(14, 4)
  refundMethod   PaymentMethod? @map("refund_method")
  reason         String?        @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company     Company     @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  shift       PosShift    @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict)
  posSale     PosSale     @relation(fields: [tenantId, posSaleId], references: [tenantId, id], onDelete: Restrict)
  salesReturn SalesReturn @relation(fields: [tenantId, salesReturnId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, idempotencyKey])
  @@unique([tenantId, salesReturnId])
  @@index([tenantId, companyId, shiftId])
  @@index([tenantId, posSaleId])
  @@map("pos_returns")
}

// ---------------------------------------------------------------------------
// Commerce (Phase 7A, docs/ROADMAP.md §11). A Storefront is the multi-store
// unit MASTER_SPEC §23 asks for — its `code` is deliberately globally
// unique, not tenant-scoped, the same precedent `Tenant.slug` already sets:
// a public storefront handle has to be resolvable from an anonymous request
// with no tenant context of its own (docs/ARCHITECTURE.md §7: "Los
// endpoints públicos ... resuelven tenant mediante ... un mapping
// previamente registrado"). StorefrontProduct is the publication join —
// only a PUBLISHED product is ever visible through the public API, keeping
// the full internal Catalog decoupled from what a given storefront chooses
// to show. Cart/CartLine are anonymous by design: no session, no
// authentication — `Cart.id` itself is the public "cart token" a shopper's
// browser holds, the same "an unguessable UUID is public-identifier-safe"
// precedent `FileObject.storageKey` already sets. CommerceOrder is the
// checkout-side counterpart to POS's own PosSale: created only after a real
// SalesOrder (channel ECOMMERCE) is confirmed through Sales' own public
// contract — see CheckoutUseCase's docstring and docs/DECISIONS.md ADR-011
// for why its idempotency is keyed by `cartId` itself rather than a
// caller-supplied key, and why `paymentId` is nullable (no credentialed
// gateway exists yet, ADR-009).
// ---------------------------------------------------------------------------

enum StorefrontStatus {
  ACTIVE
  INACTIVE
}

enum StorefrontProductStatus {
  PUBLISHED
  UNPUBLISHED
}

enum CartStatus {
  OPEN
  CONVERTED
}

/// `defaultWarehouseId` is nullable — a storefront selling only
/// `trackInventory: false` products never needs one; `CheckoutUseCase`
/// only requires it once a cart line's product actually needs a warehouse
/// (the same conditional-requirement style `SalesOrderLine.warehouseId`
/// already uses). `domain` is purely informational metadata (MASTER_SPEC
/// §23's "múltiples Storefronts") — this codebase has no real DNS/hosting
/// wired behind it, the same "not simulated, just not built" honesty
/// already applied to POS's hardware adapters (docs/DECISIONS.md ADR-010).
model Storefront {
  id                 String           @id @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  companyId          String           @map("company_id") @db.Uuid
  defaultWarehouseId String?          @map("default_warehouse_id") @db.Uuid
  code               String           @unique @db.VarChar(63)
  name               String           @db.VarChar(200)
  domain             String?          @db.VarChar(255)
  currency           String           @db.VarChar(3)
  status             StorefrontStatus @default(ACTIVE)
  version            Int              @default(1)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company          Company             @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  defaultWarehouse Warehouse?          @relation(fields: [tenantId, defaultWarehouseId], references: [tenantId, id], onDelete: Restrict)
  publications     StorefrontProduct[]
  carts            Cart[]
  commerceOrders   CommerceOrder[]

  @@unique([tenantId, id])
  @@index([tenantId, companyId])
  @@map("storefronts")
}

/// The publication join — a `Product` is never visible through the public
/// API unless it has a `PUBLISHED` row here for that specific storefront.
model StorefrontProduct {
  id           String                  @id @db.Uuid
  tenantId     String                  @map("tenant_id") @db.Uuid
  storefrontId String                  @map("storefront_id") @db.Uuid
  productId    String                  @map("product_id") @db.Uuid
  status       StorefrontProductStatus @default(PUBLISHED)
  publishedAt  DateTime                @default(now()) @map("published_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  storefront Storefront @relation(fields: [tenantId, storefrontId], references: [tenantId, id], onDelete: Restrict)
  product    Product    @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, storefrontId, productId])
  @@index([tenantId, storefrontId, status])
  @@map("storefront_products")
}

/// Anonymous by design — see the section docstring above. `status` moves
/// `OPEN -> CONVERTED` exactly once, on a successful checkout; there is no
/// abandonment job in this slice (MASTER_SPEC §59: no state with no real
/// code path behind it), so an inactive cart simply stays `OPEN` forever.
model Cart {
  id           String     @id @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  companyId    String     @map("company_id") @db.Uuid
  storefrontId String     @map("storefront_id") @db.Uuid
  currency     String     @db.VarChar(3)
  status       CartStatus @default(OPEN)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company       Company        @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  storefront    Storefront     @relation(fields: [tenantId, storefrontId], references: [tenantId, id], onDelete: Restrict)
  lines         CartLine[]
  commerceOrder CommerceOrder?

  @@unique([tenantId, id])
  @@index([tenantId, storefrontId, status])
  @@map("carts")
}

/// One line per (cart, product, variant) — `AddCartLineUseCase` increases
/// `quantity` on an existing line instead of creating a second one for the
/// same target, an application-level rule (no partial-unique index for it —
/// a cart is not money-critical data on its own, unlike `PosShift`'s "at
/// most one OPEN shift per register"). `unitPrice` is snapshotted from the
/// Catalog at add-time, the same "don't silently recompute a snapshotted
/// fact" reasoning `SalesOrderLine.unitPrice` already established.
model CartLine {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  cartId           String   @map("cart_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  productVariantId String?  @map("product_variant_id") @db.Uuid
  quantity         Decimal  @db.Decimal(14, 4)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(14, 4)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  cart           Cart            @relation(fields: [tenantId, cartId], references: [tenantId, id], onDelete: Cascade)
  product        Product         @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  productVariant ProductVariant? @relation(fields: [tenantId, productVariantId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, cartId])
  @@map("cart_lines")
}

/// The Commerce-owned record of a completed checkout — mirrors POS's own
/// `PosSale` closely (see that model's docstring), created only after a
/// real `SalesOrder` (channel ECOMMERCE) is confirmed through Sales' own
/// public contract. Two deliberate differences from `PosSale`, both
/// documented in `CheckoutUseCase`'s own docstring and ADR-011: (1)
/// idempotency is keyed by `cartId` itself, not a caller-supplied string —
/// a Cart converts at most once, so it already is the natural dedup key;
/// (2) `paymentId` is nullable and the order is never auto-fulfilled here —
/// unlike an in-person POS sale, an online order routinely gets paid
/// (BANK_TRANSFER, self-declared reference) and fulfilled (warehouse
/// pick/pack) at a *later* time, through the very same Sales/Payments
/// screens already built for every other channel.
model CommerceOrder {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  storefrontId String   @map("storefront_id") @db.Uuid
  cartId       String   @map("cart_id") @db.Uuid
  salesOrderId String   @map("sales_order_id") @db.Uuid
  paymentId    String?  @map("payment_id") @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  guestEmail   String   @map("guest_email") @db.VarChar(200)
  total        Decimal  @db.Decimal(14, 4)
  currency     String   @db.VarChar(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company    Company    @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  storefront Storefront @relation(fields: [tenantId, storefrontId], references: [tenantId, id], onDelete: Restrict)
  cart       Cart       @relation(fields: [tenantId, cartId], references: [tenantId, id], onDelete: Restrict)
  salesOrder SalesOrder @relation(fields: [tenantId, salesOrderId], references: [tenantId, id], onDelete: Restrict)
  payment    Payment?   @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)
  customer   Customer   @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, cartId])
  @@unique([tenantId, salesOrderId])
  @@unique([tenantId, paymentId])
  @@index([tenantId, companyId, storefrontId])
  @@map("commerce_orders")
}
