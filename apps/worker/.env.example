# Copy to .env and fill in for local development. Never commit the real .env.

# Health endpoint port — distinct from apps/api's 3000.
PORT=3001

# Must point at the same database as apps/api's DATABASE_URL.
# Matches docker-compose.yml's postgres service out of the box.
DATABASE_URL="postgresql://erp:erp_dev_password@localhost:5432/erp_platform?schema=public"

# Outbox dispatcher poll interval, milliseconds (docs/EVENTS.md §8.2)
OUTBOX_DISPATCH_INTERVAL_MS=2000

# Outbox retention/purge job (docs/EVENTS.md §8.2). Only PUBLISHED rows are
# ever purged — FAILED (dead-letter) rows are left for operator review.
OUTBOX_PURGE_INTERVAL_MS=3600000
OUTBOX_PURGE_RETENTION_DAYS=30
OUTBOX_PURGE_BATCH_SIZE=500

# OpenTelemetry tracing (docs/ARCHITECTURE.md §11). Read directly from
# process.env by apps/worker/src/tracing.ts — not part of EnvironmentVariables,
# since it must be resolved before Nest's ConfigModule even exists. Defaults
# to the local Jaeger service in docker-compose.yml if unset.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# Set to "false" to disable tracing entirely (e.g. a lightweight local run).
# OTEL_ENABLED=true
