# Copy to .env.local for local development. Never commit the real .env.local.

# Base URL of the Commerce Engine REST API (apps/api), including the /api/v1
# prefix. Matches apps/api's default port out of the box.
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api/v1"

# Public `code` of the Storefront record (created from the ERP's Comercio
# admin screen, apps/erp-web's "Tiendas" panel) that this deployment serves.
# This platform serves exactly one storefront per deployment for now — there
# is no hostname-routing/multi-tenant layer here yet (docs/ROADMAP.md §11).
NEXT_PUBLIC_STOREFRONT_CODE="main-store"
