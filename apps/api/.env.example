# Copy to .env and fill in for local development. Never commit the real .env.

NODE_ENV=development
PORT=3000

# Must point at the same database as packages/database/.env.
# Matches docker-compose.yml's postgres service out of the box.
DATABASE_URL="postgresql://erp:erp_dev_password@localhost:5432/erp_platform?schema=public"

# Matches docker-compose.yml's redis service out of the box.
REDIS_URL="redis://localhost:6379"

# Session/token lifetimes (seconds) — see docs/DECISIONS.md ADR-006
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Login endpoint throttling (MASTER_SPEC §87)
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# In-process outbox dispatcher poll interval, milliseconds (docs/EVENTS.md §8.2)
OUTBOX_DISPATCH_INTERVAL_MS=2000

# S3-compatible file storage (MASTER_SPEC §22). Matches docker-compose.yml's
# minio service out of the box (MINIO_ROOT_USER/MINIO_ROOT_PASSWORD).
# The bucket itself is created automatically on boot if missing (see
# S3BucketBootstrapper) — no manual `mc mb` step needed for local dev.
FILES_S3_ENDPOINT="http://localhost:9000"
FILES_S3_REGION="us-east-1"
FILES_S3_ACCESS_KEY_ID="erp_minio"
FILES_S3_SECRET_ACCESS_KEY="erp_minio_dev_password"
FILES_S3_BUCKET="erp-platform-files"
FILES_S3_FORCE_PATH_STYLE=true
FILES_MAX_SIZE_BYTES=26214400
FILES_DOWNLOAD_URL_TTL_SECONDS=300
